                    </jmeterExtensions>
                    <testPlanLibraries>
                        <artifact>com.oracle.database.jdbc:ojdbc8:19.3.0.0</artifact>
                    </testPlanLibraries>

                    <propertiesUser>
                        <app.base.url>${app.base.url}</app.base.url>
                        <app.protocol>${app.protocol}</app.protocol>
                        <app.port>${app.port}</app.port>
                        <connect.timeout>${connect.timeout}</connect.timeout>
                        <response.timeout>${response.timeout}</response.timeout>
                        <perf.schenario.name>${perf.schenario.name}</perf.schenario.name>
                        <thread.number>${thread.number}</thread.number>
                        <rampup>${rampup}</rampup>
                        <startup.delay>${startup.delay}</startup.delay>
                        <test.duration>${test.duration}</test.duration>
                        <target.rpm>${target.rpm}</target.rpm>
                        <test.folder>${test.folder}</test.folder>
                        <test.output.folder>${project.build.directory}/output</test.output.folder>
                        <jmeter.reportgenerator.report_title>JMeterReport_${perf.schenario.name}
                        </jmeter.reportgenerator.report_title>
                        <jmeter.reportgenerator.overall_granularity>500
                        </jmeter.reportgenerator.overall_granularity>
                        <jmeter.reportgenerator.exporter.html.series_filter>^(-success|-failure)?$
                        </jmeter.reportgenerator.exporter.html.series_filter>
                    </propertiesUser>
                    <!--                <testFilesIncluded>
                                        <jMeterTestFile>${test.folder}/${test.jmx.name}.jmx</jMeterTestFile>
                                        <jMeterTestFile>src/test/jmeter/jmx/obo/enterprise-order-service/example/example.jmx</jMeterTestFile>
                                    </testFilesIncluded>-->
                   <!-- <customPropertiesFiles>
                        <file>src/test/resources/obo/order/env/${app.env}.properties</file>
                    </customPropertiesFiles>-->
                   <!-- <jMeterProcessJVMSettings>
                        <xms>${jmeter.jvm.xms}</xms>
                        <xmx>${jmeter.jvm.xmx}</xmx>
                        <arguments>
                            <argument>-XX:MaxMetaspaceSize=${jmeter.jvm.MaxMetaspaceSize}</argument>
                        </arguments>
                    </jMeterProcessJVMSettings>-->
                    <testFilesDirectory>${test.folder}</testFilesDirectory>
                    <!--<resultsDirectory>${html.report.dir}</resultsDirectory>-->
                    <ignoreResultFailures>true</ignoreResultFailures>
                    <resultsFileFormat>xml</resultsFileFormat>
                    <generateReports>true</generateReports>
                    <resultsFileNameDateFormat>MMM, yyyy</resultsFileNameDateFormat>
                    <appendResultsTimestamp>true</appendResultsTimestamp>
                    <testResultsTimestamp>false</testResultsTimestamp>
                </configuration>
            </plugin>
